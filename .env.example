# Copy to .env and fill in. Never commit .env.
DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=shiftbase.example.com
CSRF_TRUSTED_ORIGINS=https://shiftbase.example.com
APP_BASE_URL=https://shiftbase.example.com
DATABASE_URL=postgres://shiftbase:CHANGE_ME@db:5432/shiftbase
POSTGRES_USER=shiftbase
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shiftbase
# Examples: smtp+tls://user:password@smtp.example.com:587  |  consolemail://  (prints to the log)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Shiftbase <no-reply@example.com>
# Optional shared cache for login rate limiting across several app processes
REDIS_URL=
# Public hostname Caddy should serve (production compose only)
SITE_ADDRESS=shiftbase.example.com
